# Meeting Summarizer Config
# Copy this to .env and fill in your keys

# Gemini API key (required) - get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-3.6-flash

# Transcription mode: "local" for whisper on your machine, "api" for groq
TRANSCRIPTION_MODE=local

# Whisper settings (only for local mode)
# Models: tiny, base, small, medium, large (medium is a good balance)
WHISPER_MODEL=medium
WHISPER_LANGUAGE=en

# Groq API key (only needed if TRANSCRIPTION_MODE=api)
GROQ_API_KEY=your_key_here

# Flask frontend -> backend URL
API_BASE_URL=http://localhost:8000/api

# Max upload size in MB
MAX_UPLOAD_SIZE_MB=100
