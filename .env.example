# ===========================
# Meeting Summarizer - Config
# ===========================

# --- Gemini LLM (Required) ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# --- Transcription Mode ---
# "local" = Whisper running on your machine (GPU recommended)
# "api"   = Groq Whisper API (no GPU needed)
TRANSCRIPTION_MODE=local

# --- Whisper Local Settings ---
# Models: tiny, base, small, medium, large
# Larger = more accurate but slower. "medium" recommended with GPU.
WHISPER_MODEL=medium
WHISPER_LANGUAGE=en

# --- Groq API (Optional, for API-based transcription) ---
GROQ_API_KEY=your_groq_api_key_here

# --- Flask Frontend ---
API_BASE_URL=http://localhost:8000/api

# --- Upload Limits ---
MAX_UPLOAD_SIZE_MB=100
